# Optional systemd drop-in environment for GWAY event sound helpers.
#
# Install by copying selected lines into a drop-in such as:
#
#   /etc/systemd/system/gway-event-sound.service.d/10-local-env.conf
#
# Do not store secrets here. These values only tune local event detection and
# playback behavior.

[Service]
Environment=GWAY_EVENT_SOUND_VOLUME=0.21
Environment=GWAY_EVENT_SOUND_POLL_SECONDS=4
Environment=GWAY_EVENT_SOUND_AP_IFACE=wlan0
Environment=GWAY_EVENT_SOUND_THERMAL_WARM_C=70
Environment=GWAY_EVENT_SOUND_THERMAL_HOT_C=75
Environment=GWAY_EVENT_SOUND_THERMAL_CRITICAL_C=80
Environment=GWAY_EVENT_SOUND_THERMAL_REPEAT_SECONDS=300
Environment=GWAY_EVENT_SOUND_UNDERVOLTAGE_REPEAT_SECONDS=60
Environment=GWAY_EVENT_SOUND_SOUND_BIN=/usr/local/bin/sound
Environment=GWAY_SOUND_EVENT_DB=/home/arthe/.local/state/gway-sound/events.sqlite3
Environment=GWAY_SOUND_GPIO_PIN=18
Environment=GWAY_SOUND_AUDIO_DEVICE=
Environment=GWAY_SOUND_ALSA_DEVICE=
Environment=GWAY_SOUND_AUDIO_GAIN=2.0
