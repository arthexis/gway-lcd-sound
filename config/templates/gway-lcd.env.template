# Optional systemd drop-in environment for GWAY LCD helpers.
#
# Install by copying selected lines into service drop-ins for:
#
#   lcd-lockfile.service
#   lcd-system-info-publisher.service
#   gway-eth0-node-lcd.service
#
# The default lock directories keep host-local state first while still reading
# the suite `.locks` directory for compatibility.

[Service]
Environment=LCD_LOCK_DIRS=/home/arthe/.local/state/lcd-lockfiles:/home/arthe/arthexis/.locks
Environment=LCD_SYSTEM_INFO_LOCK_DIR=/home/arthe/.local/state/lcd-lockfiles
Environment=LCD_ROTATION_SECONDS=10
Environment=LCD_EVENT_FRAME_SECONDS=10
Environment=LCD_POLL_SECONDS=0.5
Environment=LCD_DRIVER=auto
