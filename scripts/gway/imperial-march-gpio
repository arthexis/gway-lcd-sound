#!/usr/bin/env python3
# RFID_MODE_RESET_NAVIGATION_ON_EXIT=1
"""Play a short Imperial March motif on the local GPIO buzzer."""

from __future__ import annotations

import argparse
import fcntl
import math
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import time


DEFAULT_PIN = int(os.environ.get("NODE_SOUND_GPIO_PIN") or os.environ.get("GWAY_SOUND_GPIO_PIN", "18"))
DEFAULT_VOLUME = float(os.environ.get("IMPERIAL_MARCH_VOLUME") or os.environ.get("CODEX_SOUND_HOOK_VOLUME", "0.24"))
DEFAULT_TEMPO = float(os.environ.get("IMPERIAL_MARCH_TEMPO", "112"))
DEFAULT_TRANSPOSE = int(os.environ.get("IMPERIAL_MARCH_TRANSPOSE", "12"))
LOCK_FILE = Path(os.environ.get("CODEX_SOUND_HOOK_LOCK_FILE", "/home/arthe/.local/state/codex-sound-hooks/play.lock"))
MUTE_FILE = Path(
    os.environ.get("NODE_SOUND_GPIO_MUTE_FILE")
    or os.environ.get("GWAY_SOUND_GPIO_MUTE_FILE")
    or Path(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}") / "gway-sound" / "gpio-muted"
)
MAX_DUTY_CYCLE = 28.0
STACCATO = 0.88
NOTE_RE = re.compile(r"^([A-G])([#b]?)(-?\d+)$")
SEMITONES = {
    "C": 0,
    "D": 2,
    "E": 4,
    "F": 5,
    "G": 7,
    "A": 9,
    "B": 11,
}

# Compact one-shot arrangement for a GPIO buzzer. The default transpose moves
# the melody up one octave so the piezo speaks clearly.
MOTIF = [
    ("A3", 1.0),
    ("A3", 1.0),
    ("A3", 1.0),
    ("F3", 0.75),
    ("C4", 0.25),
    ("A3", 1.0),
    ("F3", 0.75),
    ("C4", 0.25),
    ("A3", 2.0),
    ("E4", 1.0),
    ("E4", 1.0),
    ("E4", 1.0),
    ("F4", 0.75),
    ("C4", 0.25),
    ("Ab3", 1.0),
    ("F3", 0.75),
    ("C4", 0.25),
    ("A3", 2.0),
    ("A4", 1.0),
    ("A3", 0.75),
    ("A3", 0.25),
    ("A4", 1.0),
    ("Ab4", 0.75),
    ("G4", 0.25),
    ("Gb4", 0.25),
    ("F4", 0.25),
    ("Gb4", 0.5),
    ("R", 0.5),
    ("Bb3", 0.5),
    ("Eb4", 1.0),
    ("D4", 0.75),
    ("Db4", 0.25),
    ("C4", 0.25),
    ("B3", 0.25),
    ("C4", 0.5),
    ("R", 0.5),
    ("F3", 0.5),
    ("Ab3", 1.0),
    ("F3", 0.75),
    ("A3", 0.25),
    ("C4", 1.0),
    ("A3", 0.75),
    ("C4", 0.25),
    ("E4", 2.0),
]


def clamp(value: float, lower: float, upper: float) -> float:
    return max(lower, min(upper, value))


def note_midi(note: str) -> int | None:
    if note == "R":
        return None
    match = NOTE_RE.match(note)
    if not match:
        raise ValueError(f"invalid note name: {note}")
    name, accidental, octave_text = match.groups()
    semitone = SEMITONES[name]
    if accidental == "#":
        semitone += 1
    elif accidental == "b":
        semitone -= 1
    octave = int(octave_text)
    return (octave + 1) * 12 + semitone


def note_frequency(note: str, transpose: int) -> float:
    midi_note = note_midi(note)
    if midi_note is None:
        return 0.0
    return 440.0 * (2.0 ** (((midi_note + transpose) - 69) / 12.0))


def beat_seconds(beats: float, tempo: float) -> float:
    return beats * 60.0 / tempo


def load_gpio():
    try:
        import RPi.GPIO as GPIO  # type: ignore
    except Exception as exc:
        raise RuntimeError(f"RPi.GPIO unavailable: {exc}") from exc
    return GPIO


def configure_gpio(GPIO, pin: int) -> None:
    GPIO.setwarnings(False)
    mode = GPIO.getmode()
    if mode is None:
        GPIO.setmode(GPIO.BCM)
    elif mode != GPIO.BCM:
        raise RuntimeError(f"different GPIO mode already active: {mode}")
    GPIO.setup(pin, GPIO.OUT)


def release_pin(pin: int) -> None:
    if shutil.which("pinctrl"):
        subprocess.run(["pinctrl", "set", str(pin), "ip", "pd"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)


def cleanup_gpio(GPIO, pin: int) -> None:
    try:
        GPIO.cleanup(pin)
    except Exception:
        pass
    release_pin(pin)


def play_tone(GPIO, pin: int, frequency: float, duration: float, volume: float) -> None:
    duty = clamp(volume, 0.0, 1.0) * MAX_DUTY_CYCLE
    if duty <= 0 or frequency <= 0 or duration <= 0:
        time.sleep(max(0.0, duration))
        return

    pwm = GPIO.PWM(pin, int(round(frequency)))
    pwm.start(0)
    try:
        attack = min(0.010, duration / 4)
        release = min(0.016, duration / 4)
        sustain = max(0.0, duration - attack - release)
        for step in range(1, 5):
            pwm.ChangeDutyCycle(duty * step / 4)
            time.sleep(attack / 4)
        if sustain > 0:
            time.sleep(sustain)
        for step in range(3, -1, -1):
            pwm.ChangeDutyCycle(duty * step / 4)
            time.sleep(release / 4)
    finally:
        pwm.stop()


def gpio_muted() -> bool:
    return MUTE_FILE.exists()


def play_motif(pin: int, volume: float, tempo: float, transpose: int, repeat: int, gap: float) -> None:
    GPIO = load_gpio()
    configure_gpio(GPIO, pin)
    try:
        for run in range(repeat):
            if run > 0 and gap > 0:
                time.sleep(gap)
            for note, beats in MOTIF:
                duration = beat_seconds(beats, tempo)
                frequency = note_frequency(note, transpose)
                if frequency <= 0:
                    time.sleep(duration)
                    continue
                play_tone(GPIO, pin, frequency, duration * STACCATO, volume)
                rest = duration * (1.0 - STACCATO)
                if rest > 0:
                    time.sleep(rest)
    finally:
        cleanup_gpio(GPIO, pin)


def dry_run(tempo: float, transpose: int, repeat: int, gap: float) -> None:
    total = 0.0
    for note, beats in MOTIF:
        duration = beat_seconds(beats, tempo)
        total += duration
        frequency = note_frequency(note, transpose)
        if frequency <= 0:
            print(f"{note:3s} {beats:4.2f} beats rest")
        else:
            print(f"{note:3s} {beats:4.2f} beats {frequency:7.1f} Hz")
    total = total * repeat + max(0, repeat - 1) * gap
    print(f"total={total:.2f}s tempo={tempo:.1f} repeat={repeat} transpose={transpose}")


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--pin", type=int, default=DEFAULT_PIN, help="BCM GPIO pin to use")
    parser.add_argument("--volume", type=float, default=DEFAULT_VOLUME, help="volume from 0.0 to 1.0")
    parser.add_argument("--tempo", type=float, default=DEFAULT_TEMPO, help="tempo in beats per minute")
    parser.add_argument("--transpose", type=int, default=DEFAULT_TRANSPOSE, help="semitones to transpose the motif")
    parser.add_argument("--repeat", type=int, default=1, help="number of times to play the motif")
    parser.add_argument("--gap", type=float, default=0.75, help="seconds between repeats")
    parser.add_argument("--dry-run", action="store_true", help="print notes without touching GPIO")
    args = parser.parse_args(argv)

    volume = clamp(args.volume, 0.0, 1.0)
    tempo = clamp(args.tempo, 30.0, 320.0)
    repeat = max(1, min(args.repeat, 8))
    gap = clamp(args.gap, 0.0, 10.0)

    if args.dry_run:
        dry_run(tempo, args.transpose, repeat, gap)
        return 0

    if gpio_muted():
        return 0

    LOCK_FILE.parent.mkdir(parents=True, exist_ok=True)
    with LOCK_FILE.open("w", encoding="utf-8") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        play_motif(args.pin, volume, tempo, args.transpose, repeat, gap)
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
